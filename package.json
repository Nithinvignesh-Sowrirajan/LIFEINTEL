{
  "name": "lifeintel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "backend": "python -m uvicorn main:app --app-dir backend --host 0.0.0.0 --port 8000",
    "dev:all": "concurrently -k \"npm run backend\" \"npm run dev\"",
    "electron:dev": "concurrently -k \"npm run backend\" \"npm run dev\" \"wait-on tcp:5173 && electron .\""
  },
  "dependencies": {
    "autoprefixer": "^10.6.2",
    "lucide-react": "^1.66.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "electron": "^41.2.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^8.0.4"
  },
  "allowScripts": {
    "electron@41.10.7": true
  }
}
